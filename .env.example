# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection string (Atlas). Atlas Network Access must allow Vercel (0.0.0.0/0).
DATABASE_URL=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Gemini key from https://aistudio.google.com/apikey (server-side only, no NEXT_PUBLIC_ prefix)
GOOGLE_AI_API=

# Optional: try this model before the built-in list in app/api/ai/route.ts
GEMINI_MODEL=
